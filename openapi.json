{
  "openapi": "3.1.0",
  "info": {
    "title": "МАМА рядом API",
    "version": "1.0.0",
    "description": "Демонстрационный навигатор. Реальных интеграций с ведомствами нет."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Локальная проверка. Для сдачи замените на PUBLIC_URL HTTPS."
    }
  ],
  "security": [
    {
      "BearerSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer"
      },
      "MaxWebhook": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Max-Bot-Api-Secret"
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "pregnant",
              "under18",
              "18to36",
              "3to7"
            ]
          },
          "firstChild": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ]
          },
          "children": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3"
            ]
          },
          "employment": {
            "type": "string",
            "enum": [
              "employed",
              "self",
              "unemployed",
              "student"
            ]
          },
          "income": {
            "type": "string",
            "enum": [
              "low",
              "mid",
              "high",
              "unknown"
            ]
          },
          "citizenship": {
            "type": "string",
            "enum": [
              "yes",
              "no"
            ]
          },
          "registration": {
            "type": "string",
            "enum": [
              "permanent",
              "temporary",
              "none"
            ]
          },
          "received": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "birth_leave",
                "birth",
                "care",
                "unified",
                "capital",
                "regional_capital"
              ]
            }
          }
        },
        "required": [
          "stage",
          "firstChild",
          "children",
          "employment",
          "income",
          "citizenship",
          "registration",
          "received"
        ],
        "additionalProperties": false
      },
      "Settings": {
        "type": "object",
        "properties": {
          "theme": {
            "type": "string",
            "enum": [
              "system",
              "light",
              "dark"
            ]
          },
          "fontSize": {
            "type": "string",
            "enum": [
              "small",
              "normal",
              "large"
            ]
          },
          "accessible": {
            "type": "boolean"
          },
          "deadlines": {
            "type": "boolean"
          },
          "unfinished": {
            "type": "boolean"
          },
          "lifeEvents": {
            "type": "boolean"
          },
          "service": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Auth": {
        "type": "object",
        "properties": {
          "initData": {
            "type": "string"
          },
          "demo": {
            "type": "boolean"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "Session": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer"
          }
        },
        "required": [
          "token",
          "expiresIn"
        ],
        "additionalProperties": false
      },
      "ProfileUpdate": {
        "type": "object",
        "properties": {
          "profile": {
            "$ref": "#/components/schemas/Profile"
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "consent": {
            "type": "boolean"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "additionalProperties": false
      },
      "TrackingUpdate": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "preparing",
              "submitted",
              "received",
              "action",
              "remove"
            ]
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "additionalProperties": false
      },
      "ReminderInput": {
        "type": "object",
        "properties": {
          "benefitId": {
            "type": "string"
          },
          "dueAt": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string",
            "enum": [
              "deadlines",
              "unfinished",
              "lifeEvents",
              "service"
            ]
          },
          "deleteId": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "version"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "additionalProperties": false
      },
      "Deleted": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean"
          }
        },
        "required": [
          "deleted"
        ],
        "additionalProperties": false
      },
      "Config": {
        "type": "object",
        "required": [
          "demo",
          "questions",
          "statusLabels"
        ],
        "properties": {
          "demo": {
            "type": "boolean"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "statusLabels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "State": {
        "type": "object",
        "required": [
          "profile",
          "version",
          "benefits",
          "tracking",
          "settings",
          "reminders",
          "disclosure"
        ],
        "properties": {
          "profile": {
            "type": "object",
            "description": "Profile либо незаполненный объект"
          },
          "version": {
            "type": "integer"
          },
          "benefits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Benefit"
            }
          },
          "settings": {
            "$ref": "#/components/schemas/Settings"
          },
          "tracking": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "planned",
                    "preparing",
                    "submitted",
                    "received",
                    "action",
                    "remove"
                  ]
                },
                "updatedAt": {
                  "type": "string"
                }
              }
            }
          },
          "reminders": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "disclosure": {
            "type": "string"
          },
          "botConnected": {
            "type": "boolean"
          },
          "isManyChildren": {
            "type": "boolean"
          }
        }
      },
      "Benefit": {
        "type": "object",
        "required": [
          "id",
          "title",
          "testData",
          "match",
          "amount",
          "source",
          "updatedAt",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "testData": {
            "const": true
          },
          "match": {
            "type": "string",
            "enum": [
              "eligible",
              "clarify",
              "received",
              "ineligible",
              "excluded"
            ]
          },
          "amount": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "updatedAt": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Проверка доступности",
        "responses": {
          "200": {
            "description": "Успешно",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Ошибка валидации",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Нет авторизации",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Неверный Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Конфликт версии",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Слишком большой запрос",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Лимит запросов",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": []
      }
    },
